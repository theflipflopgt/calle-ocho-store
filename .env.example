# URL publica del sitio
NEXT_PUBLIC_APP_URL=https://calleochostore.com


# Google Analytics 4 (ID publico de medicion)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PFV1T22GQT

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
# Solo servidor. Nunca usar NEXT_PUBLIC_ para esta variable.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Resend: nunca expongas esta clave en variables NEXT_PUBLIC_*
RESEND_API_KEY=re_TU_NUEVA_API_KEY
EMAIL_FROM=Calle Ocho Store <pedidos@calleochostore.com>
BUSINESS_EMAIL=TU_CORREO_PERSONAL_O_DE_VENTAS

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# Opcionales, segun las funciones que uses
INTERNAL_API_KEY=GENERA_UN_VALOR_LARGO_Y_ALEATORIO
CRON_SECRET=GENERA_OTRO_VALOR_LARGO_Y_ALEATORIO
NEWSLETTER_UNSUBSCRIBE_SECRET=GENERA_OTRO_VALOR_LARGO_Y_ALEATORIO

# Checkout: habilita pago contra entrega solo para mensajería propia en Ciudad Capital
NEXT_PUBLIC_CASH_ON_DELIVERY_ENABLED=false
CASH_ON_DELIVERY_ENABLED=false

# Analytics y marketing
# Opcional: activar cuando crees el contenedor de Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-KPCXSK7R
# Opcional: token HTML de Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# NeoPay permanece apagado hasta completar documentación y certificación de NeoNet.
NEOPAY_ENABLED=false
NEOPAY_ENVIRONMENT=sandbox
NEOPAY_MERCHANT_ID=
NEOPAY_TERMINAL_ID=
NEOPAY_API_URL=
NEOPAY_API_KEY=
NEOPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_NEOPAY_ENABLED=false
